package com.design.patterns;


class ProductSearchQuery{
	private final String category;      // Required
    private final int pageSize;         // Required
    private final Double minPrice;      // Optional
    private final Boolean inStockOnly;  // Optional
    
    private ProductSearchQuery(Builder builder) {
        this.category = builder.category;
        this.pageSize = builder.pageSize;
        this.minPrice = builder.minPrice;
        this.inStockOnly = builder.inStockOnly;
    }
    
}


public class BuilderPattern {
  public static void main(String[] args) {
    System.out.println("Hello");
  }
}
